rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Administrator authority comes only from a server-managed Firebase
    // custom claim. Never use users/{uid}.role to grant administrator access.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function ownsUserProfile(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Google, Apple, and email/password users may create only their own
      // customer profile. A client can never create an admin profile.
      allow create: if ownsUserProfile(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'role', 'loginMethod',
          'createdAt', 'updatedAt', 'lastSignedIn'
        ]);

      // Users may read their own profile. Admins may read all profiles.
      allow read: if isAdmin() || ownsUserProfile(uid);

      // Users may update safe profile fields only. `role` and `uid` are
      // immutable for client writes, which blocks self-promotion.
      allow update: if isAdmin()
        || (ownsUserProfile(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'email', 'updatedAt', 'lastSignedIn', 'loginMethod'
          ]));

      allow delete: if isAdmin();
    }

    match /shopify_sync/catalog {
      // This document contains only invalidation metadata, never products,
      // prices, inventory, or credentials.
      allow read: if true;
      allow write: if false;
    }

    match /banners/{bannerId} {
      // The storefront may read published content only. Admin SDK calls used
      // by the server bypass these rules and remain protected by tRPC adminProcedure.
      allow read: if resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    // All other application data is server-managed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
